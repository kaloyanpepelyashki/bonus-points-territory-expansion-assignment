<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Territory_Expansion_Game.ViewModels"
        x:DataType="vm:MainWindowViewModel"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Territory_Expansion_Game.Views.ReSizePopUpWindow"
        Title="ReSizePopUpWindow">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10">

                <TextBlock Text="Re-size game field"/>
                <StackPanel Margin="40"
                    >
                    <RadioButton GroupName="Resize Buttons" Content="6x6" Checked="GridSize6"/>
                    <RadioButton GroupName="Resize Buttons" Content="9x9" Checked="GridSize9"  />
                    <RadioButton GroupName="Resize Buttons" Content="12x12" Checked="GridSize12" />
                </StackPanel>
                
                <Button Content="Close" Click="ClosePopup"/>

        </StackPanel>
</Window>
